# Copy this file to `.env.local` and fill in your Supabase project values.
# Find these in the Supabase dashboard: Project Settings → API.
# The anon key is a public client key — safe to ship in the browser bundle.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: restrict logins to one school domain (leave blank to allow any Google account).
# Example: students.myschool.edu
VITE_ALLOWED_EMAIL_DOMAIN=
